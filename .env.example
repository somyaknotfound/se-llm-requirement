# Copy to .env and adjust. Every value here is local-only by design —
# there is deliberately no slot for a hosted-LLM API key anywhere in this project.

# Ollama daemon. Override only if you run the daemon on a non-default port
# or on another machine on your LAN.
OLLAMA_HOST=http://127.0.0.1:11434

# Where sentence-transformers caches all-MiniLM-L6-v2 (~90 MB).
# Set this if your user profile is on a small or synced drive (e.g. OneDrive).
# HF_HOME=D:/hf-cache

# Offline mode for the embedding model once it has been cached once.
# Set to 1 to prove at demo time that no network call is made during a run.
# HF_HUB_OFFLINE=0

# Set to 1 to make drivers refuse to overwrite an existing file in outputs/.
# Raw generated artifacts are evidence; regenerating them silently destroys the
# audit trail the report depends on.
PROTECT_OUTPUTS=0
